= check Handshake.AlertCloses
= check Handshake.AlertIsLast
= check Handshake.ClosedIsFinal
= row step open whole even strict invalid:unexpected_message => closed whole even strict alert:unexpected_message
= row step wait_finished whole even strict protected:finished_bad => closed whole even strict alert:decrypt_error
