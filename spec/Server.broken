# Each entry breaks Server.tla in one place and names the checks that must
# then fail. The format is described in Handshake.broken.

reach Full
reach Contended
reach OnePoolFull
reach Drained

# A stopping server still lets connections in.
break let-in-while-stopping
expect invariant NoneLetInWhileStopping
-    /\ conn[c] = "free"
-    /\ ~stopping
-    /\ Room(k, a)
+    /\ conn[c] = "free"
+    /\ Room(k, a)

# A stopping server does not cut its tunnels, which may then run for ever.
break tunnels-not-cut
expect property StopEnds
-        /\ WF_vars(~ended /\ Cut(c))
+        /\ TRUE

# A stopping server never exits.
break no-exit
expect property StopEnds
-    /\ WF_vars(~ended /\ Exit)
+    /\ TRUE

# An accept loop takes a slot even when none is left.
break cap-ignored
expect invariant ReservationsBounded
-    /\ used < 2 * Cap
+    /\ TRUE

# A connection is let into a pool that is full.
break pool-room-ignored
expect invariant CapRespected
-    /\ Cardinality(InPool(k)) < Cap
+    /\ TRUE

# One address may hold any number of public connections.
break address-room-ignored
expect invariant PerAddressRespected
-    /\ k = "public" => Cardinality(FromAddress(a)) < PerAddress
+    /\ TRUE

# A connection that is turned away keeps its slot.
break turned-away-keeps-slot
expect invariant SlotsAccounted
-    /\ ~Room(k, a) \/ (k = "public" /\ l \in Secure /\ ~PublicTls) \/ stopping
-    /\ accept' = [accept EXCEPT ![l] = "wait"]
-    /\ used' = used - 1
+    /\ ~Room(k, a) \/ (k = "public" /\ l \in Secure /\ ~PublicTls) \/ stopping
+    /\ accept' = [accept EXCEPT ![l] = "wait"]
+    /\ used' = used

# A connection that ends keeps its place in its pool.
break pool-kept
expect invariant PoolsAccounted
-    /\ pool' = [pool EXCEPT ![c] = "none"]
+    /\ pool' = pool

# A failed accept() keeps its slot.
break slot-lost
expect invariant SlotsAccounted
-AcceptFails(l) ==
-    /\ accept[l] = "ready"
-    /\ accept' = [accept EXCEPT ![l] = "wait"]
-    /\ used' = used - 1
+AcceptFails(l) ==
+    /\ accept[l] = "ready"
+    /\ accept' = [accept EXCEPT ![l] = "wait"]
+    /\ used' = used

# A connection gives its slot back twice.
break slot-returned-twice
expect invariant SlotsAccounted
-    /\ from' = [from EXCEPT ![c] = "none"]
-    /\ used' = used - 1
+    /\ from' = [from EXCEPT ![c] = "none"]
+    /\ used' = used - 2

# The connection's thread does not wait for the second thread.
break no-join
expect invariant NoStrayThread
-    /\ \A p \in Sides : At(c, p, "done")
-    /\ Leave(c)
-    /\ pump' = [pump EXCEPT ![c] = [p \in Sides |-> "off"]]
+    /\ At(c, "up", "done")
+    /\ Leave(c)
+    /\ pump' = [pump EXCEPT ![c]["up"] = "off"]

# A stopping pump does not shut the sockets down.
break no-shutdown
expect property TunnelEnds
-    /\ At(c, p, "stop")
-    /\ shut' = [shut EXCEPT ![c] = TRUE]
+    /\ At(c, p, "stop")
+    /\ UNCHANGED shut

# Reads and writes on a socket that is shut down may still block.
break shut-socket-blocks
expect property TunnelEnds
-            /\ WF_vars(~ended /\ shut[c] /\ (ReadEnds(c, p) \/ WriteFails(c, p)))
+            /\ TRUE

# Writes to the client have no timeout.
break no-write-timeout
expect property LockGranted
-            /\ WF_vars(~ended /\ (Written(c, p) \/ WriteFails(c, p)))
+            /\ TRUE

# A failed write keeps the write lock, so the tunnel can never end. (With
# one tunnel at a time in the model, they cannot pile up until the server
# is stuck, as they would in the real one.)
break lock-kept
expect invariant OneWriter
-    /\ lock' = [lock EXCEPT ![c] = "free"]
-    /\ Move(c, p, "stop")
+    /\ UNCHANGED lock
+    /\ Move(c, p, "stop")

# The write lock does not exclude.
break no-mutex
expect invariant OneWriter
-    /\ lock[c] = "free"
+    /\ TRUE

# The pump that copies from the client also takes the write lock for data.
break reader-takes-lock
expect invariant ReadingNeverWaits
-    /\ p = "down"
+    /\ TRUE

# A variable takes a value of the wrong kind.
break wrong-type
expect invariant TypeOK
-    /\ Move(c, p, "done")
+    /\ Move(c, p, "finished")
